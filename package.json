{
  "name": "copilot-fusion-demos",
  "version": "1.0.0",
  "private": true,
  "description": "Demonstrates GitHub Copilot Fusion workflows (Single, Critique and Cascade) with accessibility testing, live traces, recordings and measured costs.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "demo": "node src/cli.mjs",
    "checks": "node checks/run-checks.mjs",
    "screenshots": "node scripts/tutorial-screenshots.mjs",
    "lockfile:public": "node scripts/public-lockfile.mjs",
    "test": "node --test",
    "test:load": "node scripts/demo-load.mjs"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.28",
    "@playwright/mcp": "^0.0.83",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.0"
  }
}
