{
  "name": "hydrafusion-demos",
  "version": "1.0.0",
  "private": true,
  "description": "Runs a prompt for each HydraFusion pattern (Single, Critique and Cascade) against an accessibility demo page, shows each pass as it runs, and shows what each run cost.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "demo": "node src/cli.mjs",
    "checks": "node checks/run-checks.mjs",
    "lockfile:public": "node scripts/public-lockfile.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.23",
    "@playwright/mcp": "^0.0.83",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.0"
  }
}
