    {
      "id": "text-16",
      "type": "text",
      "x": 924,
      "y": 868,
      "width": 672,
      "height": 158,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 602854902,
      "version": 1,
      "versionNonce": 1433386625,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "How a live run works\n①  You click a demo in the dashboard.\n②  The server starts a new Copilot SDK session on HydraFusion.\n③  HydraFusion picks a pattern and a model for each pass.\n④  The passes test the demo page with the browser tools.\n⑤  The route, each pass and its cost stream back to the dashboard.\n⑥  The run is saved, so you can replay it for free.",
      "originalText": "How a live run works\n①  You click a demo in the dashboard.\n②  The server starts a new Copilot SDK session on HydraFusion.\n③  HydraFusion picks a pattern and a model for each pass.\n④  The passes test the demo page with the browser tools.\n⑤  The route, each pass and its cost stream back to the dashboard.\n⑥  The run is saved, so you can replay it for free.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
